import random
import time
import matplotlib.pyplot as plt


# Bubble Sort function
def bubble_sort(arr):
    n = len(arr)

    for i in range(n):
        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]


# Function to create an array of random numbers
def create_array(n):
    return [random.randint(1, 10000) for _ in range(n)]


# Lists to store array sizes and execution times
sizes = []
execution_times = []


# Run Bubble Sort for different input sizes
for n in range(1, 1001, 10):

    # Create a random array
    arr = create_array(n)

    # Record start time
    start_time = time.perf_counter()

    # Perform Bubble Sort
    bubble_sort(arr)

    # Record end time
    end_time = time.perf_counter()

    # Calculate execution time
    execution_time = end_time - start_time

    sizes.append(n)
    execution_times.append(execution_time)


# Plot the results
plt.plot(sizes, execution_times)

plt.xlabel("Array Size (n)")
plt.ylabel("Execution Time (seconds)")
plt.title("Execution Time of Bubble Sort")
plt.grid(True)

plt.show()
